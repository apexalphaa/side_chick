NODE_ENV=development
WEB_PORT=3000
API_PORT=4000
DATABASE_URL=postgresql://dating:dating@localhost:5432/dating_ai
REDIS_URL=redis://localhost:6379
SESSION_SECRET=replace-with-a-long-random-secret

# Legitimately owned provider keys only.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
ALIBABA_API_KEY=
DEEPSEEK_API_KEY=
ZAI_API_KEY=

AI_ROUTING_STRATEGY=ROUND_ROBIN
AI_MAX_RETRIES=2
AI_REQUEST_TIMEOUT_MS=30000
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_MS=30000

# 0 means no application-level spend cap; set a positive value for a hard cap.
AI_MONTHLY_SPEND_CAP_USD=0

MAX_AUTONOMOUS_INITIATIONS_PER_DAY=10
MAX_DELEGATED_MESSAGES_PER_CONVERSATION=10
DEFAULT_DELEGATION_MINUTES=60
